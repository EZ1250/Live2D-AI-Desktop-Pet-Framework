{
  "name": "pet-desktop-app",
  "productName": "Pet",
  "version": "1.0.1",
  "description": "Pet — Live2D 桌面宠物",
  "author": "EZ1250",
  "main": "dist/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "import": "node scripts/import-model.js",
    "assemble": "node scripts/assemble-renderer.js",
    "check:privacy": "node scripts/check-privacy.js --all",
    "build:tsc": "tsc -p tsconfig.json",
    "test": "npm run build:tsc && npm run assemble && node --test",
    "check": "npm test",
    "build:all": "npm run build:tsc && npm run assemble",
    "start": "chcp 65001 > nul && electron .",
    "prestart": "npm run import && npm run build:all",
    "check:tts": "node scripts/check-edge-tts.js",
    "check:vts": "node scripts/check-vts.js",
    "build": "npm run import && npm run build:tsc && npm run assemble && node scripts/build-portable.js",
    "dist": "npm run build"
  },
  "dependencies": {
    "active-win": "^8",
    "js-yaml": "^4.3.2",
    "msedge-tts": "^2.1.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^31.7.7",
    "electron-builder": "^24",
    "typescript": "^5"
  }
}
